rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ログインを許可する2人のメールアドレスに書き換えてください
    function isMember() {
      return request.auth != null
        && request.auth.token.email in ['husband@example.com', 'wife@example.com'];
    }
    match /days/{dayId} {
      allow read, write: if isMember();
    }
    match /settings/{docId} {
      allow read, write: if isMember();
    }
  }
}
